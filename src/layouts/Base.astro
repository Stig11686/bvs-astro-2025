---
import "@/styles/global.css";
import Seo, { type SeoProps } from "@/components/ui/Seo.astro";
import Header from "@/components/ui/Header.astro";
import Footer from "@/components/ui/Footer.astro";
import DarkCTA, { type CtaProps } from "@/components/ui/DarkCTA.astro";
import { site } from "@/site.config";
import { getPillar } from "@/lib/data";

interface Props extends SeoProps {
  headerCta?: "start" | "audit" | "none";
  /** The dark CTA above the footer: a pillar id, custom content, or false to hide it. */
  cta?: string | CtaProps | false;
}

const { headerCta = "start", cta = "home", ...seo } = Astro.props;

const homeCta: CtaProps = {
  heading: "Ready to get more from your *website*?",
  body: "Whether you know exactly what you need or you're not sure where to start, let's have a conversation.",
  primary: "start",
};
const ctaProps: CtaProps | null =
  cta === false ? null : typeof cta === "object" ? cta : cta === "home" ? homeCta : getPillar(cta).cta;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f3ee" />
    <Seo {...seo} />
    <link rel="icon" href="/images/favicons/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/images/favicons/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/images/favicons/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
    />
    <script is:inline define:vars={{ gaId: site.googleAnalyticsId }}>
      if (gaId && !/^(localhost|127\.0\.0\.1)$/.test(location.hostname) && !/--/.test(location.hostname)) {
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag("consent", "default", { analytics_storage: "denied", ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied", wait_for_update: 500 });
        gtag("js", new Date());
        gtag("config", gaId);
        var s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=" + gaId;
        document.head.appendChild(s);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header cta={headerCta} />
    <main id="main">
      <slot />
    </main>
    {ctaProps && <DarkCTA {...ctaProps} />}
    <Footer />
  </body>
</html>
