---
// Navy pre-footer call to action.
import Button from "./Button.astro";
import { emph } from "@/lib/text";
import { site } from "@/site.config";

interface Props {
  title?: string;
  lede?: string;
  button?: { label: string; href: string };
  link?: { label: string; href: string };
}
const {
  title = "Ready to get more from your *website?*",
  lede = "Whether you know exactly what you need or you're not sure where to start, let's have a conversation.",
  button = { label: "Get in Touch", href: "/contact/" },
  link = { label: "Or book a free call →", href: site.introCall },
} = Astro.props;
const ext = (h: string) => (/^https?:/.test(h) ? { target: "_blank", rel: "noopener" } : {});
---

<section class="ctaslab">
  <span class="tiles" aria-hidden="true"><i></i><i></i></span>
  <div class="wrap">
    <div>
      <h2 class="dh h2 rv" set:html={emph(title)} />
      <p class="lede rv">{lede}</p>
    </div>
    <div class="acts rv">
      <Button href={button.href} kind="light">{button.label}</Button>
      {link && <a class="tlink" href={link.href} {...ext(link.href)}>{link.label}</a>}
    </div>
  </div>
</section>
