---
// Accordion FAQ. Also outputs FAQPage structured data for Google.
interface Props {
  items: { question: string; answer: string }[];
  schema?: boolean;
}
const { items, schema = true } = Astro.props;
const data = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i) => ({
    "@type": "Question",
    name: i.question,
    acceptedAnswer: { "@type": "Answer", text: i.answer },
  })),
};
---

<div class="acc">
  {
    items.map((item, i) => (
      <div class={`acc-i${i === 0 ? " open" : ""}`}>
        <button class="acc-q" type="button" aria-expanded={i === 0 ? "true" : "false"}>
          <span class="n">{String(i + 1).padStart(2, "0")}</span>
          <b>{item.question}</b>
          <span class="pl" />
        </button>
        <div class="acc-a">
          <div>
            <p set:html={item.answer} />
          </div>
        </div>
      </div>
    ))
  }
</div>
{schema && <script type="application/ld+json" set:html={JSON.stringify(data)} />}
