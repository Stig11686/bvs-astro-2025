---
interface Props {
  items: { title: string; text: string }[];
}
const { items } = Astro.props;
---

<div class="feats">
  {
    items.map((f, i) => (
      <div class="feat rv">
        <span class="n">{String(i + 1).padStart(2, "0")}</span>
        <h3>{f.title}</h3>
        <p>{f.text}</p>
      </div>
    ))
  }
</div>
