---
interface Props {
  items: { title: string; text: string }[];
}
const { items } = Astro.props;
---

<div class="nrows">
  {
    items.map((r, i) => (
      <div class="nrow rv">
        <span class="n">{String(i + 1).padStart(2, "0")}</span>
        <h3>{r.title}</h3>
        <p set:html={r.text} />
      </div>
    ))
  }
</div>
