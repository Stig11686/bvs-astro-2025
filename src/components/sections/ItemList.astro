---
// Numbered rows: number, title, description.
interface Props { items: { title: string; body: string }[] }
---
<ol class="numbered numbered--3 item-list">
  {Astro.props.items.map((it) => (<li><h3 class="h3">{it.title}</h3><p>{it.body}</p></li>))}
</ol>
<style>
  .item-list h3 { font-size: 1.4rem; }
  .item-list p { font-family: var(--font-sans); font-size: .95rem; line-height: 1.6; color: var(--ink-2); margin: 0; }
  .item-list li { margin: 0 !important; }
</style>
