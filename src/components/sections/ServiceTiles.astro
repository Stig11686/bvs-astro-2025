---
// The four core services as a 2×2 grid. Tiles fill with the accent on hover.
import { pillars } from "@/lib/data";
interface Props { exclude?: string }
const items = pillars.filter((p) => p.id !== Astro.props.exclude);
---
<div class="tiles">
  {items.map((p, i) => (
    <a class="tile" href={`/services/${p.slug}/`}>
      <span class="tile__top"><span class="mono">0{i + 1}</span><span class="serif tile__arrow">→</span></span>
      <span class="tile__h serif">{p.name}</span>
      <span class="tile__b">{p.summary}</span>
    </a>
  ))}
</div>
<style>
  .tiles { display: grid; border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); }
  @media (min-width: 760px) { .tiles { grid-template-columns: repeat(2, 1fr); } }
  .tile { display: flex; flex-direction: column; min-height: 220px; padding: 30px 32px 28px; text-decoration: none !important; color: var(--ink) !important; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); transition: background .25s, color .25s; font-family: var(--font-sans); }
  .tile:hover { background: var(--accent); color: var(--dark-paper) !important; }
  .tile__top { display: flex; justify-content: space-between; font-size: 11px; letter-spacing: .12em; color: var(--ink-3); }
  .tile:hover .tile__top { color: rgba(255,255,255,.7); }
  .tile__arrow { font-style: italic; font-size: 22px; color: var(--accent); }
  .tile:hover .tile__arrow { color: var(--dark-paper); }
  .tile__h { font-size: clamp(1.5rem, 1.2rem + 1vw, 1.9rem); letter-spacing: -0.015em; line-height: 1.08; margin: 18px 0 12px; }
  .tile__b { font-size: .92rem; line-height: 1.6; color: var(--ink-2); max-width: 42ch; }
  .tile:hover .tile__b { color: rgba(255,255,255,.85); }
</style>
