---
// Responsive image. Outputs AVIF and WebP at several widths and lets the
// browser pick the right size for the screen. Pass the path as used in
// content, e.g. src="/images/blog/domain.jpg".
import { Picture } from "astro:assets";
import { getImage } from "@/lib/images";

interface Props {
  src: string;
  alt: string;
  sizes?: string;
  widths?: number[];
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
  style?: string;
}

const { src, alt, sizes = "100vw", widths, loading = "lazy", class: className, ...rest } = Astro.props;
const image = getImage(src);
const isSvg = image.format === "svg";
const candidates = widths ?? [360, 640, 960, 1280, 1600];
const usable = candidates.filter((w) => w <= image.width);
const finalWidths = usable.length ? usable : [image.width];
---

{
  isSvg ? (
    <img src={image.src} alt={alt} width={image.width} height={image.height} loading={loading} class={className} {...rest} />
  ) : (
    <Picture
      src={image}
      alt={alt}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      quality={70}
      widths={finalWidths}
      sizes={sizes}
      loading={loading}
      decoding={loading === "eager" ? "sync" : "async"}
      class={className}
      {...rest}
    />
  )
}
