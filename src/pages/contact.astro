---
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import Button from "@/components/Button.astro";
import ContactForm from "@/components/ContactForm.astro";
import AsideList from "@/components/AsideList.astro";
import { site } from "@/site.config";
---

<Base
  title="Contact BVS Web Design | Web Designer in Skipton & Keighley"
  description="Ready to turn your website into your best salesperson? Tell me a bit about your project and I'll get back to you within one working day."
>
  <PageHero
    title="Let's have a | proper *chat.*"
    lede="Tell me what's going on with your website. You'll hear back from me personally, usually within one working day. No account managers, no hard sell."
    crumbs={[{ label: "Contact" }]}
  >
    <Fragment slot="cta">
      <Button href={site.introCall} kind="acc">Book an Intro Call</Button>
      <a class="tlink" href={site.phoneHref}>Or call {site.phone}</a>
    </Fragment>
  </PageHero>

  <section class="sec contact" id="contact">
    <div class="wrap">
      <div>
        <h2 class="dh sh rv">Send me a <span class="it">message.</span></h2>
        <p class="lede rv" style="margin-top:24px">You don't need to have it all figured out. A few lines on where your website is now and what you'd like it to do is plenty.</p>
        <AsideList />
        <div class="callbox rv">
          <div><b>Rather talk it through?</b><span>Book a free 30-minute intro call.</span></div>
          <Button href={site.introCall} kind="light">Book an Intro Call</Button>
        </div>
      </div>
      <ContactForm fields={["business", "phone", "website"]} />
    </div>
  </section>
</Base>
