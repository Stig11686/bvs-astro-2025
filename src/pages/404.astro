---
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import Button from "@/components/Button.astro";
---

<Base title="Page not found | BVS Web Design" noindex>
  <PageHero title="That page has | *gone walkabout.*" lede="The link may be old, or the page has moved. Try one of these instead." class="nf">
    <Fragment slot="cta">
      <Button href="/" kind="acc">Back to the Homepage</Button>
      <a class="tlink" href="/blog/">Read the blog →</a>
      <a class="tlink" href="/contact/">Get in touch →</a>
    </Fragment>
  </PageHero>
</Base>
