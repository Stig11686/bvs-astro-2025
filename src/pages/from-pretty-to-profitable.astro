---
/**
 * From Pretty to Profitable - Landing Page
 *
 * Campaign landing page for bridal boutique outreach.
 * Captures email signups for the website rebuild case study series.
 * The form posts { firstName, email } as JSON to the Netlify function
 * at netlify/functions/subscribe.js (MailerLite).
 */
import Base from "@/layouts/Base.astro";

const pageTitle = "From Pretty to Profitable | BVS Web Design";
const pageDescription = "Follow a real bridal boutique website rebuild, from discovery to launch. Get behind-the-scenes updates as I transform a beautiful but underperforming site into one that converts.";

const calendlyUrl = import.meta.env.CALENDLY_URL || "https://tidycal.com/bvswebdesign/30-minute-meeting";
---

<Base title={pageTitle} description={pageDescription} noindex cta={false} headerCta="none">
  <!-- Hero -->
  <section class="dark gutter fp-hero">
    <div class="wrap fp-center">
      <p class="eyebrow">A BVS Web Design Case Study</p>
      <h1 class="h-hero fp-hero__h">From Pretty to <em class="accent-italic">Profitable</em></h1>
      <p class="lede fp-hero__lede">Follow a real bridal boutique website rebuild, from discovery to launch</p>
      <div class="btn-row fp-center-row">
        <a href="#signup" class="btn btn--accent">
          Follow the journey
          <svg class="fp-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="tint gutter section">
    <div class="wrap fp-center fp-narrow">
      <p class="fp-big serif">A beautiful website should be your best salesperson.</p>
      <p class="fp-big serif">For too many boutique owners, it isn't.</p>
      <p class="lede">The site looks stunning. You're proud of it. But the enquiries aren't coming in the way they should, and you're not sure why.</p>
      <p class="fp-familiar serif">Sound familiar?</p>
    </div>
  </section>

  <!-- Story -->
  <section class="gutter section rule-top">
    <div class="wrap fp-story">
      <div class="fp-story__text">
        <p class="h3">I audited a bridal boutique with exactly this problem.</p>
        <p class="body-serif">Great design. Real traffic. Almost no leads.</p>
        <p class="body-serif">What I found surprised even me: £18,000 a year in unnecessary spend across hosting, management and ads, while the site failed to convert the visitors it was already getting.</p>
        <p class="body-serif">So I'm rebuilding it properly, and I'm documenting every decision along the way.</p>
      </div>
      <div class="fp-center">
        <span class="fp-figure serif">£18k</span>
        <span class="label fp-figure__label">wasted per year</span>
      </div>
    </div>
  </section>

  <!-- What you'll get -->
  <section class="tint gutter section">
    <div class="wrap">
      <div class="fp-center">
        <h2 class="h2">What You'll Get</h2>
        <p class="lede fp-sub">Behind-the-scenes access to every stage of the rebuild</p>
      </div>
      <div class="ruled ruled--3 fp-cards">
        <div class="fp-card">
          <p class="card-num">01</p>
          <h3 class="h3">The Discovery</h3>
          <p>What the audit uncovered and why it matters</p>
        </div>
        <div class="fp-card">
          <p class="card-num">02</p>
          <h3 class="h3">The Rebuild</h3>
          <p>Every key decision explained in plain English</p>
        </div>
        <div class="fp-card">
          <p class="card-num">03</p>
          <h3 class="h3">The Results</h3>
          <p>What happens when a website is built to convert</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Email capture -->
  <section class="gutter section rule-top" id="signup">
    <div class="wrap fp-center fp-form-wrap">
      <h2 class="h2">Follow the build. It's free.</h2>
      <p class="lede fp-sub">Get behind-the-scenes updates as the rebuild progresses: honest insights from a real project, no jargon.</p>

      <div id="form-container">
        <form class="fp-form" id="signup-form">
          <p id="form-error" class="fp-error" role="alert" hidden></p>
          <div class="fp-form__row">
            <label>
              <span class="visually-hidden">First name</span>
              <input type="text" name="firstName" placeholder="First name" required autocomplete="given-name" />
            </label>
            <label>
              <span class="visually-hidden">Email address</span>
              <input type="email" name="email" placeholder="Email address" required autocomplete="email" />
            </label>
          </div>
          <button type="submit" class="btn btn--solid fp-submit" id="submit-btn">
            <span id="btn-text">Join the journey</span>
            <span id="btn-spinner" hidden>Submitting...</span>
          </button>
        </form>
        <p class="label fp-note">No spam. Unsubscribe any time.</p>
      </div>

      <div id="success-message" class="fp-success" hidden>
        <p class="h3">You're in.</p>
        <p>First email is on its way.</p>
      </div>
    </div>
  </section>

  <!-- Secondary CTA -->
  <section class="dark gutter section">
    <div class="wrap fp-center fp-narrow">
      <h2 class="h2">Already know your website has a problem?</h2>
      <p class="lede fp-sub">Skip the journey. Book a free 30-minute audit call and let's take a look together.</p>
      <div class="btn-row fp-center-row">
        <a href={calendlyUrl} target="_blank" rel="noopener noreferrer" class="btn btn--accent">Book a free call</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById("signup-form") as HTMLFormElement | null;
  const formContainer = document.getElementById("form-container") as HTMLDivElement;
  const successMessage = document.getElementById("success-message") as HTMLDivElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const btnText = document.getElementById("btn-text") as HTMLSpanElement;
  const btnSpinner = document.getElementById("btn-spinner") as HTMLSpanElement;
  const errorEl = document.getElementById("form-error") as HTMLParagraphElement;

  function showError(message: string) {
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  function clearError() {
    errorEl.hidden = true;
  }

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    btnText.hidden = loading;
    btnSpinner.hidden = !loading;
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearError();

    const formData = new FormData(form);
    const firstName = (formData.get("firstName") as string)?.trim();
    const email = (formData.get("email") as string)?.trim();

    if (!firstName || !email) {
      showError("Please fill in all fields.");
      return;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      showError("Please enter a valid email address.");
      return;
    }

    setLoading(true);

    try {
      const response = await fetch("/.netlify/functions/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ firstName, email }),
      });

      const result = await response.json();

      if (response.ok && result.success) {
        formContainer.hidden = true;
        successMessage.hidden = false;
      } else {
        showError(result.error || "Something went wrong. Please try again.");
        setLoading(false);
      }
    } catch (error) {
      console.error("Form submission error:", error);
      showError("Unable to submit. Please check your connection and try again.");
      setLoading(false);
    }
  });
</script>

<style>
  [hidden] { display: none !important; }
  .fp-center { text-align: center; }
  .fp-center-row { justify-content: center; }
  .fp-narrow { max-width: 760px; }

  .fp-hero { padding-top: clamp(72px, 11vw, 128px); padding-bottom: clamp(72px, 11vw, 128px); }
  .fp-hero__h { margin: 18px auto 0; max-width: 14ch; }
  .fp-hero__lede { margin: 22px auto 0; max-width: 36ch; }
  .fp-hero .btn-row { margin-top: 32px; }
  .fp-icon { width: 16px; height: 16px; }

  .fp-big { font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.1rem); line-height: 1.3; letter-spacing: -0.012em; color: var(--ink); }
  .fp-big + .fp-big { margin-top: 10px; }
  .fp-narrow .lede { margin: 24px auto 0; max-width: 52ch; }
  .fp-familiar { margin-top: 20px; font-size: 1.3rem; font-style: italic; color: var(--accent); }

  .fp-story { display: grid; gap: clamp(28px, 5vw, 56px); align-items: center; max-width: 1080px; }
  @media (min-width: 800px) { .fp-story { grid-template-columns: 1fr 1fr; } }
  .fp-story__text > * + * { margin-top: 1em; }
  .fp-figure { display: block; font-size: clamp(4.5rem, 3rem + 7vw, 9rem); font-style: italic; line-height: 0.9; letter-spacing: -0.03em; color: var(--accent); }
  .fp-figure__label { display: block; margin-top: 12px; }

  .fp-sub { margin: 14px auto 0; max-width: 46ch; }
  .fp-cards { margin: clamp(32px, 5vw, 48px) auto 0; max-width: 1080px; background: var(--paper); }
  .fp-card { padding: clamp(22px, 3vw, 32px); text-align: left; }
  .fp-card h3 { margin-top: 10px; }
  .fp-card p:last-child { margin-top: 8px; color: var(--ink-2); }

  .fp-form-wrap { max-width: 620px; }
  #form-container { margin-top: 32px; }
  .fp-form { display: flex; flex-direction: column; gap: 14px; text-align: left; }
  .fp-form__row { display: grid; gap: 14px; }
  @media (min-width: 560px) { .fp-form__row { grid-template-columns: 1fr 1fr; } }
  .fp-form input { width: 100%; background: var(--paper); border: 1px solid var(--rule); padding: 13px 14px; font-size: 15px; color: var(--ink); border-radius: 0; }
  .fp-form input:focus { outline: 2px solid var(--accent); outline-offset: 0; border-color: transparent; }
  .fp-submit { width: 100%; }
  .fp-error { border: 1px solid #9b1c1c; color: #9b1c1c; padding: 12px 14px; font-size: .95rem; }
  .fp-note { margin-top: 14px; }
  .fp-success { margin-top: 32px; border: 1px solid var(--rule); border-left: 2px solid var(--accent); background: var(--paper-2); padding: clamp(22px, 3vw, 32px); }
  .fp-success p:last-child { margin-top: 6px; color: var(--ink-2); }
</style>
