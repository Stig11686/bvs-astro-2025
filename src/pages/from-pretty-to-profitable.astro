---
// Campaign landing page (not in the sitemap). Sign-ups go to MailerLite
// through netlify/functions/subscribe.js.
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import Button from "@/components/Button.astro";
import Features from "@/components/Features.astro";
import { site } from "@/site.config";
---

<Base
  title="From Pretty to Profitable | BVS Web Design"
  description="Follow a real bridal boutique website rebuild, from discovery to launch. Behind-the-scenes updates as I turn a beautiful but underperforming site into one that converts."
  noindex
>
  <PageHero
    title="From pretty | to *profitable.*"
    lede="Follow a real bridal boutique website rebuild, from discovery to launch."
    crumbs={[{ label: "A BVS Web Design case study" }]}
  >
    <Fragment slot="cta"><a class="tlink" href="#join">Follow the journey ↓</a></Fragment>
    <div class="factcard" slot="aside">
      <div class="big">£18k</div>
      <p><b>wasted per year</b> across hosting, management and ads, while the site failed to convert the visitors it already had.</p>
    </div>
  </PageHero>

  <section class="sec">
    <div class="wrap split">
      <h2 class="dh sh rv">A beautiful website should be your best <span class="it">salesperson.</span></h2>
      <div class="prose-lg rv">
        <p class="ink">For too many boutique owners, it isn't.</p>
        <p>The site looks stunning. You're proud of it. But the enquiries aren't coming in the way they should, and you're not sure why.</p>
        <p>I audited a bridal boutique with exactly this problem. Great design. Real traffic. Almost no leads.</p>
        <p>What I found surprised even me: £18,000 a year in unnecessary spend across hosting, management and ads, while the site failed to convert the visitors it was already getting.</p>
        <p class="ink">So I'm rebuilding it. Properly. <em>And I'm documenting every decision along the way.</em></p>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <h2 class="dh sh rv">What you'll <span class="it">get.</span></h2>
      <Features
        items={[
          { title: "The discovery", text: "What the audit uncovered and why it matters." },
          { title: "The rebuild", text: "Every key decision explained in plain English." },
          { title: "The results", text: "What happens when a website is built to convert." },
        ]}
      />
    </div>
  </section>

  <div class="slab audit on-dark" id="join">
    <section class="sec">
      <div class="wrap">
        <div>
          <h2 class="dh h2 rv">Follow the build. <span class="it">It's free.</span></h2>
          <p class="lede rv">Behind-the-scenes updates as the rebuild progresses. Honest insights from a real project, no jargon.</p>
        </div>
        <form class="aform rv" data-subscribe>
          <input type="text" name="firstName" placeholder="First name" aria-label="First name" required autocomplete="given-name" />
          <input type="email" name="email" placeholder="Your email" aria-label="Your email" required autocomplete="email" />
          <button class="btn btn--light mag" type="submit"><span class="lbl">Join the Journey</span><span class="ar"><i>→</i><i>→</i></span></button>
          <p class="aok" role="status">You're in. The first email is on its way.</p>
          <p class="err" role="alert">That didn't work. Please try again in a moment.</p>
          <p style="grid-column:1/-1;font-size:14px;color:rgba(255,255,255,.7)">No spam. Unsubscribe any time.</p>
        </form>
      </div>
    </section>
  </div>

  <section class="ctaslab" style="margin-top:clamp(10px,1.5vw,20px)">
    <span class="tiles" aria-hidden="true"><i></i><i></i></span>
    <div class="wrap">
      <div>
        <h2 class="dh h2 rv">Already know your website has a <span class="it">problem?</span></h2>
        <p class="lede rv">Skip the journey. Book a free 30-minute audit call and let's take a look together.</p>
      </div>
      <div class="acts rv"><Button href={site.introCall} kind="light">Book a Free Call</Button></div>
    </div>
  </section>
</Base>
