---
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/Img.astro";
import Faq from "@/components/Faq.astro";
import NumberedRows from "@/components/NumberedRows.astro";
import XSell from "@/components/XSell.astro";
import ContactSection from "@/components/ContactSection.astro";
import AsideList from "@/components/AsideList.astro";
import { site } from "@/site.config";

// Prices: yearly shows first. Edit both yearly and monthly figures here.
const plans = [
  {
    name: "Essentials",
    year: "£350", month: "£35",
    you: "your website does a small job, does it well, and you want it kept safe without thinking about it.",
    items: ["Managed WordPress hosting", "Weekly off-site backups", "Core, theme and plugin updates", "Uptime monitoring", "1 hour of edits a month", "Email support"],
    not: "your business changes through the year and the site has to keep up. Look at Active.",
  },
  {
    name: "Active",
    year: "£990", month: "£99",
    featured: true,
    you: "your business changes through the year, your website has to keep up, and you would rather send it to someone than wrestle with it yourself.",
    items: ["Everything in Essentials", "2 hours of edits a month, usually same day", "Monthly accuracy check with a written summary", "Same-day priority fixes", "Security hardening and malware scans", "Quarterly performance check"],
    not: "you want the site growing enquiries month on month. That is Growth.",
  },
  {
    name: "Growth",
    year: "£2,490", month: "£249",
    you: "your website is a main source of enquiries and you want more of them.",
    items: ["Everything in Active", "Monthly review of your search and traffic data", "One improvement chosen, built and shipped each month", "A written report: what changed, what moved, what is next", "Quarterly review of the quarter’s work"],
    not: "your site gets under about 500 visits a month. There is not enough data to tell a real improvement from a fluke, and I would rather sell you Active plus a one-off piece of work to fix the traffic first.",
    setup: "Setup: £195 one-off to establish tracking and a baseline. Waived if I built the site.",
  },
];

const covers = [
  { title: "Hosting that is managed.", text: "Your site sits on fast, secure WordPress hosting I look after directly. No separate hosting bill to chase, no support desk in another time zone." },
  { title: "Updates, checked before they go live.", text: "WordPress core, your theme and your plugins all need regular updating. Skip it and you get broken layouts, security holes, or a site that stops loading. I apply updates and check nothing breaks afterwards." },
  { title: "Backups you will not need to think about.", text: "Weekly off-site backups, so if the worst happens your site comes back rather than a month of lost work." },
  { title: "Security and monitoring.", text: "Uptime monitoring on every plan, with hardening and malware scans on Active and Growth. You hear from me if something is wrong, usually before you have noticed." },
  { title: "You send it, I post it.", text: "Ever tried adding a photo to your own site and hit a wall? On Active and Growth that is my job. Send me the photos and the words and I will get them live, at the right size and looking as they should." },
];

const faq = [
  { question: "Which plan do most businesses start on?", answer: "Active. It suits any business that changes through the year, which is most of them. Essentials suits sites doing a smaller, steadier job. Growth suits businesses ready to put real work into the site every month." },
  { question: "What is the difference between Active and Growth?", answer: "On Active you decide what changes and I make it happen, plus I check the site monthly for anything that has gone out of date. On Growth I look at your data, decide what should change, build it, and report on what it did." },
  { question: "What do I receive on Growth?", answer: "A report each month naming what I changed, what the numbers did, and what I am working on next. Plus the change itself, built and live." },
  { question: "How much does website maintenance cost?", answer: "Plans start at £35 a month, or £350 for the year. The right one depends on how much you lean on your site. A site doing a small job needs less than one bringing in daily enquiries." },
  { question: "Can I move between plans?", answer: "Yes, any month. Most people start on Essentials or Active and move up when the site starts mattering more to the business." },
  { question: "Why is there a setup fee on Growth?", answer: "Improvements only mean something if you can measure them, and on most sites I take over the tracking has gaps. Month one is spent fixing that and recording where you are starting from. If I built the site, that work is done and there is no fee." },
  { question: "Do I have to commit to a year?", answer: "No. Every plan runs month to month if you prefer. The annual option exists because it is cheaper for you, and because Growth needs time to show what it is doing." },
  { question: "Do I need a care plan for a WordPress site?", answer: "Yes. WordPress and its plugins release security patches constantly, and a site left un-updated for months is the most common way small business sites get hacked or break." },
  { question: "Do you only work with Yorkshire businesses?", answer: "I am based in Skipton and work with businesses across Yorkshire, but care plans are handled remotely so location is not a barrier. Plenty of clients I have never met in person, and I look after their sites the same way." },
];
---

<Base
  title="Website Maintenance & Care Plans | BVS Web Design"
  description="Website care plans for growing businesses: hosting, updates, backups and security, all handled by a real person in Skipton. From £35/month or £350/year."
  schema={{
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Website maintenance",
    name: "Website care plans",
    url: `${site.url}/services/website-support/`,
    areaServed: [{ "@type": "Place", name: "Skipton" }, { "@type": "Place", name: "North Yorkshire" }, { "@type": "Country", name: "United Kingdom" }],
    provider: { "@type": "ProfessionalService", name: site.name, url: site.url },
    offers: plans.map((p) => ({
      "@type": "Offer",
      name: `${p.name} care plan`,
      price: p.month.replace(/[£,]/g, ""),
      priceCurrency: "GBP",
      priceSpecification: { "@type": "UnitPriceSpecification", price: p.month.replace(/[£,]/g, ""), priceCurrency: "GBP", unitCode: "MON" },
    })),
  }}
>
  <PageHero
    title="Care plans that | keep your site | *working.*"
    lede="One plan keeps your site safe, one keeps it accurate, one keeps it improving. All handled by a real person in Skipton, not a ticket queue."
    crumbs={[{ label: "Services", href: "/services/" }, { label: "Care Plans" }]}
    shapes={["var(--alt-t)", "var(--acc-t)"]}
  >
    <Fragment slot="cta">
      <Button href={site.startProject} kind="acc">Book a Quick Call</Button>
      <a class="tlink" href="#enquire">Send a Message →</a>
    </Fragment>
    <div class="factcard" slot="aside">
      <div class="big">£35</div>
      <p><b>a month to start.</b> Pay monthly and cancel any time, or pay for the year and get two months free.</p>
    </div>
  </PageHero>

  <section class="sec">
    <div class="wrap">
      <div class="split">
        <h2 class="dh sh rv">Three stages, and most businesses <span class="it">know which one</span> they're at.</h2>
        <div class="prose-lg rv">
          <p>A website needs different things at different points in a business, so website maintenance means different things too.</p>
          <p>Some sites do a small job and do it well. Some sites carry the business, and have to keep up or they start telling customers things that stopped being true months ago. And some sites are a main source of enquiries, and need work aimed at something specific every month.</p>
          <p class="ink">Paying for the third when you need the first is waste. <em>I would rather tell you that than sell it to you.</em></p>
        </div>
      </div>
      <div class="ladder">
        <div class="rung tone-blue rv"><span class="n">01</span><div><h3>Essentials</h3><p>I keep it running</p></div></div>
        <div class="rung tone-acc rv"><span class="n">02</span><div><h3>Active</h3><p>I keep it right</p></div></div>
        <div class="rung tone-navy rv"><span class="n">03</span><div><h3>Growth</h3><p>I keep it improving</p></div></div>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="split">
        <h2 class="dh sh rv">A site left alone does not <span class="it">stay still.</span></h2>
        <div class="prose-lg rv">
          <p>Nothing about a neglected website looks urgent until the morning it stops working.</p>
          <p>Plugins fall behind. Security gaps open up. The contact form stops sending and you find out when a customer mentions they emailed twice.</p>
        </div>
      </div>
      <div class="compare">
        <div class="cmp bad rv"><h4>Left to drift</h4><ul><li><span>✕</span>Plugins fall out of date</li><li><span>✕</span>Security gaps open up</li><li><span>✕</span>The contact form stops sending</li><li><span>✕</span>You find out when a customer says the site is down</li></ul></div>
        <div class="cmp good rv"><h4>On a care plan</h4><ul><li><span>✓</span>Updates applied and tested before they break</li><li><span>✓</span>Security monitored, hardened and patched</li><li><span>✓</span>Forms checked, with an alert the moment one fails</li><li><span>✓</span>You hear about it from me, usually already fixed</li></ul></div>
      </div>
      <p class="cmp-note rv">That is Essentials. You stop thinking about the site and <span class="it">it carries on working.</span></p>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap split">
      <h2 class="dh sh rv sticky-h">The problem nobody <span class="it">logs a ticket for.</span></h2>
      <div class="prose-lg rv">
        <p>Your website was accurate the day it launched. Then you put your prices up in March, dropped a service, took on two new people and changed your hours over the summer.</p>
        <p>None of that breaks anything. No error, no downtime, no alert. The site carries on telling customers what was true last year, and they believe it, because why would they not.</p>
        <p class="ink">That is what Active is for.</p>
        <p>Send me changes as they happen and I put them live, usually the same day. No wrestling with image sizes, no fighting the page builder, no adding it to a list you never get to.</p>
        <p>Then once a month I go through the site against reality. Forms tested end to end, key pages checked, contact details, opening hours, prices, services, staff, broken links. I fix what I can fix and send you a short note covering what I found, what I sorted, and the handful of things only you can answer.</p>
        <p class="ink">Most business owners know their site has drifted without having a list of what needs changing. <em>Active hands you the list.</em></p>
      </div>
    </div>
  </section>

  <div class="slab rev on-dark">
    <section class="sec">
      <div class="wrap split">
        <h2 class="dh sh rv">A real <span class="it">person.</span></h2>
        <figure class="rv">
          <blockquote style="font-family:var(--serif);font-weight:500;font-size:clamp(26px,2.6vw,38px);line-height:1.25;letter-spacing:-.02em">
            “I have had poor experience in the past from other website designers: limited help, poor response times, and extortionate charging for small tasks. Steve is definitely the opposite of this and I have no plans to instruct anyone else any time soon.”
          </blockquote>
          <figcaption style="display:flex;gap:14px;align-items:center;margin-top:28px">
            <Img src="/images/testimonial/elizabeth.jpg" alt="" sizes="56px" widths={[112]} style="width:56px;height:56px;border-radius:50%;object-fit:cover" />
            <div><b style="display:block">Elizabeth Matfin</b><span style="font-size:15px;color:rgba(255,255,255,.7)">Maidens &amp; Ravens Bridal Boutique, York</span></div>
          </figcaption>
        </figure>
      </div>
    </section>
  </div>

  <section class="sec">
    <div class="wrap split">
      <h2 class="dh sh rv sticky-h">What <span class="it">“improving the site”</span> means in practice.</h2>
      <div class="prose-lg rv">
        <p>Most website support stops at keeping the lights on. Useful, and it tells you nothing about whether your site brings in more work this year than last.</p>
        <p class="ink">On Growth, one thing changes every month.</p>
        <p>I look at what people search to find you, which pages they land on, and where they leave. From that I pick the biggest single opportunity. I build that change, then check the following month what it did before choosing the next one.</p>
        <p>At the end of each month you get a report naming three things: what I changed, what moved, and what I am doing next.</p>
        <p>After a quarter you have three changes, three sets of numbers, and a view of what your website responds to. <em>That is the part most business owners have not had before.</em></p>
        <div class="story-box"><p>Month one sets the baseline. On most sites the tracking has gaps, so I fix that first. Reporting starts in month two, once the numbers can be trusted.</p></div>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap"><p class="callout rv">On Active, you decide what changes and I make it happen. On Growth, I look at the data, tell you what should change, <span class="it">and do it.</span></p></div>
  </section>

  <section class="sec" style="padding-top:0" id="plans">
    <div class="wrap">
      <div class="split">
        <h2 class="dh sh rv">Pick your <span class="it">plan.</span></h2>
        <div class="rv">
          <p class="lede">Pay monthly and cancel any time, or pay for the year and take two months off. No lock-in either way.</p>
          <div class="pill-toggle" role="group" aria-label="Billing"><i></i><button class="on" data-bill="year" aria-pressed="true">Pay yearly · 2 months free</button><button data-bill="month" aria-pressed="false">Pay monthly</button></div>
        </div>
      </div>
      <div class="plans">
        {
          plans.map((p) => (
            <article
              class={`plan rv${p.featured ? " feat" : ""}`}
              data-year={`${p.year}<small> /year</small>`}
              data-year-alt={`or ${p.month} a month`}
              data-month={`${p.month}<small> /month</small>`}
              data-month-alt="Cancel any time"
            >
              {p.featured && <span class="pop">Most popular</span>}
              <h3>{p.name}</h3>
              <div class="price">{p.year}<small> /year</small></div>
              <div class="alt">or {p.month} a month</div>
              <p class="you"><b>This is you if</b> {p.you}</p>
              <ul>{p.items.map((i) => <li><span>✓</span>{i}</li>)}</ul>
              <p class="not"><b>Not for you if</b> {p.not}</p>
              {p.setup && <p class="setup">{p.setup}</p>}
              <Button href={site.startProject} kind={p.featured ? "dark" : "acc"}>{`Choose ${p.name}`}</Button>
            </article>
          ))
        }
      </div>
      <p class="plans-note rv">If you leave part way through a year, I refund the months you have not used.</p>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap split">
      <h2 class="dh sh rv">Paying for <span class="it">the year.</span></h2>
      <div class="prose-lg rv">
        <p>Every plan runs month to month if you want it to. Pay for the year instead and you get two months free.</p>
        <p>Annual makes most sense on Growth. One improvement a month needs three months before the numbers mean anything, and closer to nine before the effect compounds. Judging that work after six weeks tells you nothing.</p>
        <p>So we review at six months. If it is not doing what you hoped, we change what I am working on, or you leave and I refund the months you have not used. <em>Committing to a year should not mean being stuck for one.</em></p>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <h2 class="dh sh rv">What <span class="it">every plan</span> covers.</h2>
      <NumberedRows items={covers} />
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap split">
      <h2 class="dh sh rv sticky-h">The things people <span class="it">ask first.</span></h2>
      <div class="rv"><Faq items={faq} /></div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="split">
        <h2 class="dh sh rv">A care plan keeps a <span class="it">working</span> site working.</h2>
        <p class="lede rv">If that's not where you are right now, you probably need something else first, and I'd rather point you to the right thing than sell you the wrong one.</p>
      </div>
      <XSell
        items={[
          { tag: "Website Rescue", title: "Your site's already broken, inherited, or your developer's vanished?", text: "That's a rescue job. I take it over, get you back in control of your own site, and sort out what's wrong.", href: "/services/website-rescue/" },
          { tag: "Website Design", title: "No site yet, or yours is well overdue a rebuild?", text: "Start from the ground up with a new WordPress site built around getting enquiries, then keep it on a care plan afterwards.", href: "/services/website-design/" },
        ]}
      />
    </div>
  </section>

  <ContactSection
    id="enquire"
    title="Tell me where you're at. *I'll tell you which plan fits.*"
    lede="You don't need to have picked a plan. Say where the site sits in your business and I'll come back with the honest answer, even when that answer is the cheaper one."
    form={{
      fields: ["website"],
      selectLabel: "Where's your business at?",
      selectPlaceholder: "Pick the one that sounds most like you",
      options: [
        { label: "My site does a small job. I want it kept safe and off my plate", value: "support_care" },
        { label: "My business changes through the year and the site has to keep up", value: "support_care" },
        { label: "My site is a main source of enquiries and I want more of them", value: "support_care" },
        { label: "Not sure yet. Tell me which one fits", value: "not_sure" },
      ],
      messageLabel: "Anything else worth knowing?",
      messagePlaceholder: "Who looks after the site now, what keeps going wrong, what you'd like it to do.",
      success: "Thanks, that's with me. I'll come back to you within one working day with a straight answer on which plan fits.",
    }}
  >
    <AsideList />
  </ContactSection>
</Base>
