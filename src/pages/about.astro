---
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/Img.astro";
import NumberedRows from "@/components/NumberedRows.astro";
import Reviews from "@/components/Reviews.astro";
import CtaSlab from "@/components/CtaSlab.astro";
import { site } from "@/site.config";

const how = [
  { title: "I talk about your business, not just your website.", text: "Before I touch any design, I want to understand who your customers are, what they need to see before they trust you, and what's currently getting in the way of them getting in touch." },
  { title: "I build around conversion, not just aesthetics.", text: "Every decision (layout, copy, calls to action, page structure) is made with one question in mind: will this help a visitor take the next step?" },
  { title: "You get a website you're proud of and a business that benefits.", text: "Most of my clients tell me they didn't realise how much their old website was costing them until they saw what a new one could do." },
];
---

<Base
  title="About Steve Marks | Web Designer, Skipton | BVS Web Design"
  description="I'm Steve Marks, a freelance web designer based in Skipton, North Yorkshire. I build WordPress websites that generate enquiries for local service businesses."
  schema={{
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Steve Marks",
    jobTitle: "Web Designer",
    worksFor: { "@type": "Organization", name: site.name, url: site.url },
    address: { "@type": "PostalAddress", addressLocality: "Skipton", addressRegion: "North Yorkshire", addressCountry: "GB" },
  }}
>
  <PageHero
    title="Hi, I'm Steve. | I build websites | that *earn their keep.*"
    lede="I'm a freelance web designer based in Skipton, North Yorkshire. I work with local service businesses whose websites look fine on the surface but aren't bringing in the enquiries their owners deserve."
    crumbs={[{ label: "About" }]}
  >
    <Fragment slot="cta">
      <Button href="/services/website-audit/" kind="acc">Book a Free Website Review</Button>
      <a class="tlink" href="/portfolio/">See My Work →</a>
    </Fragment>
    <div class="about-photo" slot="aside">
      <Img src="/images/steve/office.webp" alt="Steve Marks, web designer in Skipton" sizes="(min-width: 1000px) 440px, 90vw" widths={[440, 880]} loading="eager" />
    </div>
  </PageHero>

  <section class="sec">
    <div class="wrap split">
      <h2 class="dh sh rv sticky-h">Built to bring in <span class="it">enquiries.</span></h2>
      <div class="prose-lg rv">
        <p>There's no shortage of web designers in Yorkshire. Most of them will build you something that looks good, hand you the login details, and wish you luck.</p>
        <p class="ink">That's not how I work.</p>
        <p>I got into this because I kept seeing the same problem: business owners investing in a website, then wondering why nobody was getting in touch. The design looked fine. The branding was nice. But the phone wasn't ringing.</p>
        <p>The issue was almost never the design. It was the strategy behind it. Unclear calls to action. No thought given to what a visitor needs to see before they trust you. Contact forms that went nowhere.</p>
        <p class="ink">So I build websites to bring in leads. That starts with the outcome you want, <em>more enquiries,</em> and works back to the design.</p>
      </div>
    </div>
  </section>

  <section class="band-res tone-blue">
    <div class="sec">
      <div class="wrap">
        <div>
          <div class="num rv">30+<small>enquiries a month for Ilkley Dental Care, from the same traffic.</small></div>
        </div>
        <div class="prose-lg rv">
          <p class="ink">Ilkley Dental Care had a website that looked decent but was silently losing them patients. The contact form was broken. The phone number was buried. Visitors couldn't find what they needed.</p>
          <p class="ink">After a rebuild focused on getting people to make contact, they went from almost no online enquiries to 30+ per month.</p>
          <div style="margin-top:26px"><a class="tlink" href="/portfolio/ilkley-dental-care/">Read the full Ilkley Dental story →</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2 class="dh sh rv">What working with me <span class="it">looks like.</span></h2>
      <NumberedRows items={how} />
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap split">
      <h2 class="dh sh rv sticky-h">A bit <span class="it">about me.</span></h2>
      <div class="prose-lg rv">
        <p>I've been designing and building websites for years, and I'm based in Skipton in the Yorkshire Dales. I work with service businesses across Yorkshire, from Ilkley and Keighley to York and beyond.</p>
        <p class="ink">I work as a freelancer, which means you deal directly with me from the first conversation to launch day and beyond. <em>No account managers, no handoffs, no surprises.</em></p>
        <p>When a project calls for specialist skills like copywriting, photography or SEO, I bring in trusted collaborators from my network. But I'm always your main point of contact and always responsible for the outcome.</p>
      </div>
    </div>
  </section>

  <Reviews />

  <CtaSlab
    title="Ready to find out what your website *could be doing?*"
    lede="Start with a free website review. I'll look at your current site and tell you the three most important things holding it back, whether you end up working with me or not."
    button={{ label: "Book a Free Website Review", href: "/services/website-audit/" }}
    link={{ label: "Or see my work →", href: "/portfolio/" }}
  />
</Base>
