<style>
  .label {
    font-family: var(--font-secondary);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .text-ink-2 {
    color: var(--color-ink-2, #44403c);
  }
  .text-ink-3 {
    color: var(--color-ink-3, rgba(20, 19, 14, 0.55));
  }
  .bg-stone-2 {
    background-color: var(--color-stone-2, #e7e5e3);
  }
  .btn-ghost {
    border: 1px solid var(--color-dark, #14130e);
    background: transparent;
    color: var(--color-dark, #14130e);
  }
  .btn-ghost:hover {
    background: var(--color-dark, #14130e);
    color: var(--color-paper, #f4f3ee);
  }
  .btn-ghost-style {
    border: 1px solid var(--color-dark, #14130e) !important;
    background: transparent !important;
    color: var(--color-dark, #14130e) !important;
  }
  .btn-ghost-style:hover {
    background: var(--color-dark, #14130e) !important;
    color: var(--color-paper, #f4f3ee) !important;
  }

  /* Contact form styling */
  #enquiry :global(a) {
    color: white;
  }
  #enquiry :global(a:hover) {
    color: var(--color-accent);
  }

  /* Pricing toggle */
  .bg-border-light {
    background-color: var(--color-border-light, #d6d3d1);
  }
  #pricing-toggle[aria-checked="true"] {
    background-color: var(--color-accent);
  }
  #pricing-toggle[aria-checked="true"] #toggle-dot {
    transform: translateX(1.375rem);
    background-color: white;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toggle = document.getElementById("pricing-toggle");
    const monthlyLabel = document.getElementById("pricing-label-monthly");
    const yearlyLabel = document.getElementById("pricing-label-yearly");
    const yearlyPrompt = document.getElementById("yearly-prompt");
    const monthlyPrices = document.querySelectorAll(".price-monthly");
    const yearlyPrices = document.querySelectorAll(".price-yearly");

    if (!toggle) return;

    toggle.addEventListener("click", () => {
      const isYearly = toggle.getAttribute("aria-checked") === "true";

      if (isYearly) {
        // Switch to monthly
        toggle.setAttribute("aria-checked", "false");
        monthlyLabel?.classList.remove("text-ink-2");
        monthlyLabel?.classList.add("text-dark");
        yearlyLabel?.classList.remove("text-dark");
        yearlyLabel?.classList.add("text-ink-2");
        yearlyPrompt?.classList.remove("hidden");
        monthlyPrices.forEach((el) => el.classList.remove("hidden"));
        yearlyPrices.forEach((el) => el.classList.add("hidden"));
      } else {
        // Switch to yearly
        toggle.setAttribute("aria-checked", "true");
        monthlyLabel?.classList.remove("text-dark");
        monthlyLabel?.classList.add("text-ink-2");
        yearlyLabel?.classList.remove("text-ink-2");
        yearlyLabel?.classList.add("text-dark");
        yearlyPrompt?.classList.add("hidden");
        monthlyPrices.forEach((el) => el.classList.add("hidden"));
        yearlyPrices.forEach((el) => el.classList.remove("hidden"));
      }
    });
  });
</script>
