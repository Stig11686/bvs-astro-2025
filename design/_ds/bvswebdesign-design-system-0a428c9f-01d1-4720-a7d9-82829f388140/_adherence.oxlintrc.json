{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "components/sections/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Geist))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Geist."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlogCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:cat|date|read|title|excerpt|image|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<BlogCard> doesn't accept that prop. Declared props: cat, date, read, title, excerpt, image, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|size|href|target|type|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: kind, size, href, target, type, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:solid|accent|outline|ghost|light|ghost-dark)$/]",
        "message": "<Button> kind must be one of 'solid' | 'accent' | 'outline' | 'ghost' | 'light' | 'ghost-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DarkCTA'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|heading|body|primary|secondary|key|ref|className|style|children)$/]",
        "message": "<DarkCTA> doesn't accept that prop. Declared props: eyebrow, heading, body, primary, secondary."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onChange|key|ref|className|style|children)$/]",
        "message": "<FilterBar> doesn't accept that prop. Declared props: items, active, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|email|blurb|legal|onNavigate|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: columns, email, blurb, legal, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='HelpCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|body|href|onClick|key|ref|className|style|children)$/]",
        "message": "<HelpCard> doesn't accept that prop. Declared props: index, title, body, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:accent|children|style|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: accent, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberedRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|title|body|variant|key|ref|className|style|children)$/]",
        "message": "<NumberedRow> doesn't accept that prop. Declared props: n, title, body, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberedRow'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:wide|stacked)$/]",
        "message": "<NumberedRow> variant must be one of 'wide' | 'stacked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoHero'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|eyebrow|heading|sub|actions|height|key|ref|className|style|children)$/]",
        "message": "<PhotoHero> doesn't accept that prop. Declared props: image, eyebrow, heading, sub, actions, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='Placeholder'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|height|src|alt|radius|badge|style|key|ref|className|style|children)$/]",
        "message": "<Placeholder> doesn't accept that prop. Declared props: label, height, src, alt, radius, badge, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PortfolioCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:client|sector|stat|image|comingSoon|size|href|onClick|key|ref|className|style|children)$/]",
        "message": "<PortfolioCard> doesn't accept that prop. Declared props: client, sector, stat, image, comingSoon, size, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='PortfolioCard'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:compact|large)$/]",
        "message": "<PortfolioCard> size must be one of 'compact' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReviewCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|role|photo|photoLabel|shape|stars|style|key|ref|className|style|children)$/]",
        "message": "<ReviewCard> doesn't accept that prop. Declared props: quote, name, role, photo, photoLabel, shape, stars, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReviewCard'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:face|site)$/]",
        "message": "<ReviewCard> shape must be one of 'face' | 'site'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReviewsCarousel'] > JSXAttribute > JSXIdentifier[name!=/^(?:reviews|perView|heading|eyebrow|ratingText|key|ref|className|style|children)$/]",
        "message": "<ReviewsCarousel> doesn't accept that prop. Declared props: reviews, perView, heading, eyebrow, ratingText."
      },
      {
        "selector": "JSXOpeningElement[name.name='StarRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|color|size|key|ref|className|style|children)$/]",
        "message": "<StarRow> doesn't accept that prop. Declared props: n, color, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|sub|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: value, label, sub."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|multiline|rows|placeholder|value|onChange|name|invalid|hint|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, type, multiline, rows, placeholder, value, onChange, name, invalid, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|items|services|onNavigate|cta|secondary|sticky|key|ref|className|style|children)$/]",
        "message": "<TopNav> doesn't accept that prop. Declared props: active, items, services, onNavigate, cta, secondary, sticky."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnderLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<UnderLink> doesn't accept that prop. Declared props: href, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, color, onClick, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
